{
  "name": "backendbootcamp",
  "private": true,
  "type": "module",
  "scripts": {
    "css": "tailwindcss -i src/css/tailwind.css -o assets/css/app.css --minify",
    "css:watch": "tailwindcss -i src/css/tailwind.css -o assets/css/app.css --watch",
    "dev": "npm run css && hugo server -D",
    "build": "npm run css && hugo --gc --minify",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "tailwindcss": "^4.3.5"
  }
}
